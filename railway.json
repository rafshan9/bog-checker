{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watch": ["backend/**"],
    "rootDir": "backend"
  },
  "deploy": {
    "startCommand": "python manage.py migrate && gunicorn backend.wsgi --log-file -",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
